# SPDX-License-Identifier: Apache-2.0

# Postfix on a dedicated inbound MX. Set the public hostname for each node.
compatibility_level = 3.6
myhostname = mx1.example.org
inet_interfaces = all
queue_directory = /var/spool/postfix

# A domain is eligible for relay only if it has a route to RX.
mydestination =
relay_domains = hash:/etc/postfix/transport
transport_maps = hash:/etc/postfix/transport
relay_recipient_maps =
default_transport = error:Outbound mail is disabled on this MX
relay_transport = error:No RX route for this domain
smtpd_relay_restrictions = reject_unauth_destination
smtpd_reject_unlisted_recipient = yes
smtpd_sasl_auth_enable = no
smtpd_milters = inet:127.0.0.1:11332
milter_default_action = tempfail

# STARTTLS for public ingress, verified TLS for the fixed private next hop.
smtpd_tls_security_level = may
smtpd_tls_cert_file = /etc/postfix/tls/fullchain.pem
smtpd_tls_key_file = /etc/postfix/tls/privkey.pem
smtp_host_lookup = native
smtp_tls_security_level = secure
smtp_tls_secure_cert_match = nexthop
smtp_tls_CAfile = /etc/postfix/tls/rx-ca.pem

# Retain accepted mail when RX erroneously rejects a recipient or message.
smtp_reply_filter = regexp:/etc/postfix/rx_reply_filter

# 25 MiB per message and 1 GiB of free space reserved on the queue volume.
message_size_limit = 26214400
queue_minfree = 1073741824
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
queue_run_delay = 5m
minimal_backoff_time = 5m
maximal_backoff_time = 1h
enable_long_queue_ids = yes
