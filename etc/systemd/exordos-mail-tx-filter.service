# SPDX-License-Identifier: Apache-2.0

[Unit]
Description=Exordos Mail sender policy and DKIM signing
RequiresMountsFor=/persist

[Service]
Type=simple
Restart=on-failure
User=exordos-mail-sign
Group=exordos-mail-tx
SupplementaryGroups=exordos-mail-sign
NoNewPrivileges=yes
RuntimeDirectory=exordos-mail-tx-filter
RuntimeDirectoryMode=0750
CacheDirectory=exordos-mail-tx-filter
CacheDirectoryMode=0750
EnvironmentFile=/etc/exordos_metapaas/mail.env
ExecStart=/usr/bin/rspamd -f -c /usr/local/share/exordos-mail/rspamd-tx.conf
ExecStartPost=/usr/bin/timeout 30 /bin/bash -c 'until test -S /run/exordos-mail-tx-filter/milter.sock; do sleep 0.2; done'
