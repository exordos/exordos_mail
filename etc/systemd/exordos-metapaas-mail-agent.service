[Unit]
Description=Exordos MetaPaaS Mail dataplane agent
Wants=network-online.target exordos-bootstrap.service
After=network-online.target exordos-bootstrap.service

[Service]
TimeoutStopSec=5
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
ExecStartPre=/bin/sleep 2
ExecStart=exordos-universal-agent --config-file /etc/exordos_metapaas/metapaas_mail_agent.conf

[Install]
WantedBy=multi-user.target
