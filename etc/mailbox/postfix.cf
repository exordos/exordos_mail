# SPDX-License-Identifier: Apache-2.0

compatibility_level = 3.6
myhostname = mail.@DOMAIN@
inet_interfaces = all
mydestination =
relay_domains = @DOMAIN@
relay_recipient_maps =
virtual_alias_maps = hash:/persist/mail/control/recipients
transport_maps = regexp:/etc/postfix/exordos-mail-transport
default_transport = error:Outbound mail is disabled on RX
relay_transport = error:No inbound route
smtpd_relay_restrictions = reject_unauth_destination
smtpd_sasl_auth_enable = no
smtpd_tls_security_level = encrypt
smtpd_tls_cert_file = /persist/mail/tls/rx.crt
smtpd_tls_key_file = /persist/mail/tls/rx.key
smtpd_milters = inet:127.0.0.1:11332
milter_default_action = tempfail
queue_directory = /persist/mail/postfix
message_size_limit = 26214400
queue_minfree = 1073741824
enable_long_queue_ids = yes
